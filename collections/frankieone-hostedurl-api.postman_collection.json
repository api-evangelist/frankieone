                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationRef\": \"<string>\",\n  \"channelRef\": \"<string>\",\n  \"consent\": \"<boolean>\",\n  \"customerRef\": \"<string>\",\n  \"entityId\": \"<string>\",\n  \"errorRedirectURL\": \"<string>\",\n  \"oneSDKFlowId\": \"<string>\",\n  \"phoneCode\": \"<string>\",\n  \"phoneNumber\": \"<string>\",\n  \"recipientName\": \"<string>\",\n  \"sendSMS\": \"<boolean>\",\n  \"successRedirectURL\": \"<string>\",\n  \"comment\": {\n    \"text\": \"<string>\"\n  }\n}",

              {
                "name": "X-Frankie-CustomerChildID",
                "value": ""
              },
              {
                "name": "X-Frankie-Channel",
                "value": ""
              },
              {
                "name": "X-Frankie-Username",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Unique FrankieOne identifier for an entity"
              },
              {
                "name": "serviceName",
                "value": "",
                "type": "path",
                "description": "The unique name of the service profile"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }

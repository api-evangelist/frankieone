{
  "opencollection": "1.0.0",
  "info": {
    "name": "Core V2 Audit HostedURL API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "HostedURL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Provide hosted url for a hosted version of onesdk.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.uat.frankie.one/v2/individuals/hostedurl",
            "headers": [
              {
                "name": "api_key",
                "value": ""
              },
              {
                "name": "X-Frankie-CustomerID",
                "value": ""
              },
              {
                "name": "X-Frankie-CustomerChildID",
                "value": ""
              },
              {
                "name": "X-Frankie-Channel",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "header"
            }
          },
          "docs": "Hosted OneSDK URL Generation, used to request a hosted OneSDK URL with entity specific token for a customer to use a hosted OneSDK session to do an action. Examples of actions that may be done is to complete their onboarding process or to re-attempt IDV checks.  If sendSMS is true and a phone number is supplied, an SMS will be sent to the phone number with the generated URL."
        }
      ]
    }
  ],
  "bundled": true
}